# AlgoVerse Backend Environment Variables Template
# Copy this file to .env and populate actual keys

SECRET_KEY=django-insecure-algoverse-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Clerk Authentication Verification
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

# PostgreSQL Database Credentials
DATABASE_URL=postgres://user:password@localhost:5432/algoverse_db
DATABASE_NAME=algoverse_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
